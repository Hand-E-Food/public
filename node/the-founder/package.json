    "watch:static": "cpx \"static/**\" dist --watch",
    "watch:ts": "tsc --watch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.5",
    "@types/typescript": "^0.4.29",
